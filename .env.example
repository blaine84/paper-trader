FINNHUB_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Free Alpaca market data defaults to IEX. Use sip only with a paid data plan.
ALPACA_DATA_FEED=iex

# Postgres connection (leave commented for SQLite fallback)
# DATABASE_URL=postgresql+psycopg://paper_trader:password@127.0.0.1:5432/paper_trader

ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6

LLM_LOW_PROVIDER=ollama
LLM_LOW_MODEL=mistral:latest
LLM_MED_PROVIDER=ollama
LLM_MED_MODEL=llama3.1:8b
OLLAMA_BASE_URL=
OLLAMA_TIMEOUT=300
OLLAMA_NUM_CTX=8192
OLLAMA_FALLBACK_PROVIDER=anthropic
OLLAMA_FALLBACK_MODEL=claude-haiku-4-5

# Finance tier (fin-llama3.1-8b via Ollama)
LLM_FINANCE_PROVIDER=ollama
LLM_FINANCE_MODEL=fin-llama3.1:8b-finance
OLLAMA_FINANCE_TIMEOUT=300  # optional, defaults to OLLAMA_TIMEOUT
OLLAMA_FINANCE_NUM_CTX=8192  # optional, defaults to OLLAMA_NUM_CTX


STARTING_BALANCE=100000
# Core regime + sector context + high-beta leaders (always tracked)
WATCHLIST=SPY,QQQ,IWM,DIA,TLT,GLD,XLK,XLF,XLE,TSLA,NVDA,AMD
# Non-core tickers that should always be analyst/PM eligible if they produce valid signals
PM_TRADABLE_SYMBOLS=META,MU
# Liquid candidate pool for Scout to filter by price move, volume, catalyst, technicals
SCOUT_CANDIDATES=AAPL,MSFT,META,AMZN,GOOGL,AVGO,SMCI,PLTR,COIN,MSTR,ARM,MU,INTC,NFLX
LOOP_INTERVAL_MINUTES=15

# PM candidate-ID rollout
# disabled: legacy PM only
# shadow: candidate path is evaluated without executing; legacy PM remains authoritative
# enabled: candidate-ID path is authoritative for new entries
PM_CANDIDATE_MODE=disabled
PM_BENCHMARK_CONTEXT_ENABLED=false
PM_ALIGNMENT_POLICY_MODE=disabled

# Slack report forwarding — optional, leave empty to disable
# Create a Slack bot at https://api.slack.com/apps and add chat:write scope
CEO_SLACK_BOT_TOKEN=
CEO_SLACK_CHANNEL_ID=

# Google Blogger publishing — optional, leave empty to disable
# Narratives are posted to a Blogger blog as a public/archival record
# Set up OAuth2 credentials at https://console.cloud.google.com/apis/credentials
BLOGGER_BLOG_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ─── Alert Dispatch Deduplication ─────────────────────────────────────────────
# Controls whether the dispatcher uses material_occurrence_count for
# deferral/dedup decisions instead of the raw occurrence_count.
# disabled: existing behavior (occurrence_count drives dispatch decisions)
# enabled:  material_occurrence_count drives dispatch and deferral logic
ALERT_MATERIAL_OCCURRENCE_MODE=disabled

# Material price change threshold as a decimal fraction (0.005 = 0.5%).
# Trigger-price changes AT or BELOW this threshold are NOT considered material.
# Only changes strictly greater than threshold increment material_occurrence_count.
ALERT_MATERIAL_PRICE_THRESHOLD_PCT=0.005

# Runtime load-shedding toggles for constrained local model hosts
NARRATOR_ENABLED=true
NEWS_MONITOR_ENABLED=true
PRICE_MONITOR_LLM_FILTER_ENABLED=true

# Market-data outage remediation. When enabled, all-symbol quote failures are
# persisted as health alerts and then restart the orchestrator process. launchd
# KeepAlive is expected to bring the service back.
MARKET_DATA_OUTAGE_RESTART_ENABLED=false
MARKET_DATA_OUTAGE_RESTART_COOLDOWN_SECONDS=900
MARKET_DATA_OUTAGE_RESTART_EXIT_CODE=75
MARKET_DATA_OUTAGE_RESTART_STATE_PATH=logs/market_data_restart_state.json

# Analyst/PM focus mode: rank the broad candidate universe deterministically,
# then spend market-hours LLM attention only on the top N focus symbols.
ANALYST_FOCUS_MODE=disabled
ANALYST_FOCUS_MAX_SYMBOLS=3

# ─── Coordinated Market Cycle Scheduler ───────────────────────────────────────
# Controls whether the coordinated market cycle runner is active.
# When enabled, replaces the independent APScheduler jobs with a single
# sequential pipeline: Analyst refresh → PM decisioning → execution.
PM_CYCLE_COORDINATOR_MODE=disabled

# Maximum seconds for the analyst refresh phase before timeout.
CYCLE_ANALYST_TIMEOUT_SECONDS=180

# Maximum seconds for the PM decisioning phase before timeout.
CYCLE_PM_TIMEOUT_SECONDS=300

# Maximum signal age (seconds) before a signal is considered stale.
# Signals older than this window are excluded from the PM decision set.
PM_SIGNAL_FRESHNESS_WINDOW_SECONDS=120

# Duration (seconds) of the decision window during which the price monitor
# suppresses Finnhub polling for watchlist symbols to preserve API budget.
CYCLE_DECISION_WINDOW_SECONDS=90

# Market snapshot cache TTL in seconds (P1 budget optimization).
CYCLE_SNAPSHOT_TTL_SECONDS=90

# Maximum Finnhub API calls allowed per cycle (P1 budget optimization).
CYCLE_FINNHUB_BUDGET=40

# ─── Pending Limit Orders ───────────────────────────────────────────────────
# Converts the runaway-entry stale-entry rejection into a resting paper limit
# order instead of discarding the intent. The stale-entry rejection itself is
# unchanged — order creation is strictly additive, and execute_trade() still
# returns False for the cycle in which the runaway is detected.
#
# disabled: execute_trade() behavior unchanged; no orders, no monitor job
# observe:  orders created and evaluated; fills logged as pending_order_would_fill
#           but never executed (zero trading behavior change)
# enabled:  detected crossings execute after full fill-time revalidation
PENDING_ORDER_MODE=disabled

# Monitor cadence (seconds). Bars are 1-minute by default, so polling faster
# than the bar interval gains nothing.
PENDING_ORDER_MONITOR_INTERVAL_SECONDS=60

# Fallback active-window length (minutes) for setup types not listed in
# PENDING_ORDER_EXPIRY_MINUTES_BY_SETUP (see utils/gate_config.py). Always
# clamped by ENTRY_WINDOW_LIMITS and by the 16:00 ET session close — orders
# never rest overnight in v1.
PENDING_ORDER_DEFAULT_EXPIRY_MINUTES=120

# Upper bound on how far price may have run beyond the intended entry and still
# justify resting an order.
#
# NOTE: non-binding under current execute_trade() ordering. The live-quote
# deviation tiers run BEFORE the stale-entry check — Tier 2 (>5%, <=10%)
# overwrites the entry with the live quote and rescales the geometry, and
# Tier 3 (>10%) returns outright. So the runaway branch only ever observes
# roughly 1%-5% and nothing above ~5% reaches this guard.
PENDING_ORDER_MAX_RUNAWAY_PCT=0.05

# Gap-through threshold. When the crossing bar's OPEN is already beyond the
# limit by more than this fraction, the market gapped past the level rather
# than trading down to it, which invalidates the stop and target derived from
# the pre-gap structure. Such orders CANCEL rather than fill.
PENDING_ORDER_MAX_GAP_THROUGH_PCT=0.015

# Cap on concurrent active orders per profile.
#
# BUYING POWER IS NOT RESERVED AT CREATION. It is re-checked at fill time via
# the position sizer and validate_trade(). This cap is what bounds the
# resulting overcommitment risk. A pending order that can no longer be funded
# at fill time cancels with reason insufficient_buying_power.
PENDING_ORDER_MAX_ACTIVE_PER_PROFILE=5

# OHLC resolution for crossing detection (1, 5, 15, 30, 60). Passed to
# FinnhubClient.get_candles(), which routes Alpaca -> yfinance -> Finnhub for
# sub-daily resolutions. Only the Finnhub leg consumes the shared quote budget.
PENDING_ORDER_BAR_RESOLUTION=1

# Maximum age (seconds) of a crossing bar at the moment of the fill attempt.
# This is the compensating control for bypassing execute_trade()'s deviation
# tiers on the price-authoritative fill path — it is the only remaining
# guarantee that the fill price reflects recent market reality.
PENDING_ORDER_MAX_FILL_BAR_AGE_SECONDS=180

# Phase 3 lever, DELIBERATELY UNIMPLEMENTED in v1. Would divert Repair_Band
# (>5%, <=10% deviation) decisions to a pending order at the original intended
# entry instead of repairing to the live price and executing. That is a
# behavior change to live execution rather than an additive one, so it needs
# the pending_order_declined(repaired_before_check) evidence first. Setting
# this true has no effect in v1.
PENDING_ORDER_DIVERT_REPAIR_BAND=false
