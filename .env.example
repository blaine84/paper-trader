FINNHUB_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Free Alpaca market data defaults to IEX. Use sip only with a paid data plan.
ALPACA_DATA_FEED=iex

# Postgres connection (leave commented for SQLite fallback)
# DATABASE_URL=postgresql+psycopg://paper_trader:password@127.0.0.1:5432/paper_trader

ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6

LLM_LOW_PROVIDER=ollama
LLM_LOW_MODEL=mistral:latest
LLM_MED_PROVIDER=ollama
LLM_MED_MODEL=llama3.1:8b
OLLAMA_BASE_URL=
OLLAMA_TIMEOUT=300
OLLAMA_NUM_CTX=8192
OLLAMA_FALLBACK_PROVIDER=anthropic
OLLAMA_FALLBACK_MODEL=claude-haiku-4-5

# Finance tier (fin-llama3.1-8b via Ollama)
LLM_FINANCE_PROVIDER=ollama
LLM_FINANCE_MODEL=fin-llama3.1:8b-finance
OLLAMA_FINANCE_TIMEOUT=300  # optional, defaults to OLLAMA_TIMEOUT
OLLAMA_FINANCE_NUM_CTX=8192  # optional, defaults to OLLAMA_NUM_CTX


STARTING_BALANCE=100000
# Core regime + sector context + high-beta leaders (always tracked)
WATCHLIST=SPY,QQQ,IWM,DIA,TLT,GLD,XLK,XLF,XLE,TSLA,NVDA,AMD
# Non-core tickers that should always be analyst/PM eligible if they produce valid signals
PM_TRADABLE_SYMBOLS=META,MU
# Liquid candidate pool for Scout to filter by price move, volume, catalyst, technicals
SCOUT_CANDIDATES=AAPL,MSFT,META,AMZN,GOOGL,AVGO,SMCI,PLTR,COIN,MSTR,ARM,MU,INTC,NFLX
LOOP_INTERVAL_MINUTES=15

# PM candidate-ID rollout
# disabled: legacy PM only
# shadow: candidate path is evaluated without executing; legacy PM remains authoritative
# enabled: candidate-ID path is authoritative for new entries
PM_CANDIDATE_MODE=disabled
PM_BENCHMARK_CONTEXT_ENABLED=false
PM_ALIGNMENT_POLICY_MODE=disabled

# Slack report forwarding — optional, leave empty to disable
# Create a Slack bot at https://api.slack.com/apps and add chat:write scope
CEO_SLACK_BOT_TOKEN=
CEO_SLACK_CHANNEL_ID=

# Google Blogger publishing — optional, leave empty to disable
# Narratives are posted to a Blogger blog as a public/archival record
# Set up OAuth2 credentials at https://console.cloud.google.com/apis/credentials
BLOGGER_BLOG_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ─── Alert Dispatch Deduplication ─────────────────────────────────────────────
# Controls whether the dispatcher uses material_occurrence_count for
# deferral/dedup decisions instead of the raw occurrence_count.
# disabled: existing behavior (occurrence_count drives dispatch decisions)
# enabled:  material_occurrence_count drives dispatch and deferral logic
ALERT_MATERIAL_OCCURRENCE_MODE=disabled

# Material price change threshold as a decimal fraction (0.005 = 0.5%).
# Trigger-price changes AT or BELOW this threshold are NOT considered material.
# Only changes strictly greater than threshold increment material_occurrence_count.
ALERT_MATERIAL_PRICE_THRESHOLD_PCT=0.005

# Runtime load-shedding toggles for constrained local model hosts
NARRATOR_ENABLED=true
NEWS_MONITOR_ENABLED=true
PRICE_MONITOR_LLM_FILTER_ENABLED=true

# Analyst/PM focus mode: rank the broad candidate universe deterministically,
# then spend market-hours LLM attention only on the top N focus symbols.
ANALYST_FOCUS_MODE=disabled
ANALYST_FOCUS_MAX_SYMBOLS=3

# ─── Coordinated Market Cycle Scheduler ───────────────────────────────────────
# Controls whether the coordinated market cycle runner is active.
# When enabled, replaces the independent APScheduler jobs with a single
# sequential pipeline: Analyst refresh → PM decisioning → execution.
PM_CYCLE_COORDINATOR_MODE=disabled

# Maximum seconds for the analyst refresh phase before timeout.
CYCLE_ANALYST_TIMEOUT_SECONDS=180

# Maximum seconds for the PM decisioning phase before timeout.
CYCLE_PM_TIMEOUT_SECONDS=300

# Maximum signal age (seconds) before a signal is considered stale.
# Signals older than this window are excluded from the PM decision set.
PM_SIGNAL_FRESHNESS_WINDOW_SECONDS=120

# Duration (seconds) of the decision window during which the price monitor
# suppresses Finnhub polling for watchlist symbols to preserve API budget.
CYCLE_DECISION_WINDOW_SECONDS=90

# Market snapshot cache TTL in seconds (P1 budget optimization).
CYCLE_SNAPSHOT_TTL_SECONDS=90

# Maximum Finnhub API calls allowed per cycle (P1 budget optimization).
CYCLE_FINNHUB_BUDGET=40

# ─── Triggered Trade Plans ────────────────────────────────────────────────────
# Separates PM-approved trade plans from triggered execution. A plan describes an
# intended entry zone + trigger condition; the plan monitor promotes it to a fill
# only when a fresh quote satisfies the trigger.
# disabled: existing single-pass candidate pipeline unchanged (zero behavior change)
# observe:  trade plans created and trigger evaluations logged, execution unchanged
# enabled:  PM acceptance creates plans; fills require plan trigger confirmation
TRIGGERED_PLAN_MODE=disabled

# Plan monitor cadence (seconds) — independent of PM cycle scheduling.
PLAN_MONITOR_INTERVAL_SECONDS=30

# Default plan TTL (minutes) — untriggered plans expire after this window.
PLAN_DEFAULT_EXPIRATION_MINUTES=60

# Fractional tolerance applied to entry zone bounds at trigger evaluation time
# only (never baked into derived zone bounds). 0.005 == 0.5% of entry reference.
PLAN_ENTRY_ZONE_TOLERANCE_PCT=0.005

# Consecutive in-zone monitor ticks required when a plan demands confirmation.
PLAN_TRIGGER_CONFIRMATION_TICKS=2

# Maximum acceptable quote age (seconds) for plan execution. Older quotes are
# treated as unavailable — execution is fail-closed on quote freshness.
PLAN_EXECUTION_MAX_QUOTE_AGE_SECONDS=5

# Maximum acceptable quote age (seconds) for trigger evaluation. Cached quotes
# within this age are used instead of calling a provider.
PLAN_TRIGGER_QUOTE_MAX_AGE_SECONDS=30

# Minimum interval (seconds) between quote provider calls for any single symbol,
# enforced across monitor ticks.
QUOTE_PROVIDER_MIN_SECONDS_PER_SYMBOL=30

# Global cap on outbound quote provider calls per rolling minute from the
# plan monitor / plan executor.
QUOTE_PROVIDER_MAX_CALLS_PER_MINUTE=40
